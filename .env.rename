# ==========================
# Telegram API
# ==========================

API_ID=12345678
API_HASH=your_api_hash_here

# Телефон используется только для первичной авторизации.
# После входа Telethon хранит авторизацию в SESSION_NAME.
PHONE=+70000000000


# ==========================
# Proxy
# ==========================
# Telegram traffic is terminated on this host.
# Leave empty when this server has direct Telegram access.
PROXY=


# ==========================
# Session
# ==========================
SESSION_NAME=sessions/account


# ==========================
# FastAPI Server
# ==========================
HOST=0.0.0.0
PORT=8000


# ==========================
# API Security
# ==========================
# Required. Generate a long random value and put the same value
# into TELEGRAM_API_KEY on the Telegram Web UI host.
API_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_TOKEN
